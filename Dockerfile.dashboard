FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir \
    streamlit==1.28.2 \
    numpy==1.23.5 \
    pandas==2.0.3 \
    sqlalchemy==2.0.29 \
    psycopg2-binary==2.9.9 \
    plotly==5.14.1
COPY sentinel_dashboard.py .
CMD ["streamlit", "run", "sentinel_dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
