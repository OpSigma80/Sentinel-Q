# Sentinel-Q — Environment Variables Example
#
# Copy this file to .env and fill in your values before deploying.
#
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# All secrets marked CHANGE_ME must be replaced with strong random values.
# Generate secrets with: openssl rand -hex 32

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=sentinel_db

# Full connection URL used by SQLAlchemy.
# Must match the values above and the db service hostname.
DATABASE_URL=postgresql://sentinel:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/sentinel_db

# ─────────────────────────────────────────────
# API key (legacy — used before JWT; keep for backward compat)
# ─────────────────────────────────────────────
API_KEY=CHANGE_ME_STRONG_API_KEY

# ─────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Secret used to sign JWT tokens. Must be long and random.
JWT_SECRET_KEY=CHANGE_ME_32_CHAR_MINIMUM_SECRET
JWT_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────
# Telegram Bot (optional — disable by leaving blank)
# ─────────────────────────────────────────────
# Obtain from @BotFather — format: 123456789:ABCdefGHI...
BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN

# Your personal or group chat ID — get it from @userinfobot
CHAT_ID=CHANGE_ME_TELEGRAM_CHAT_ID

# ─────────────────────────────────────────────
# Alerting thresholds (optional — safe defaults shown)
# ─────────────────────────────────────────────
# How many consecutive failures before alert fires
ALERT_FAILURE_THRESHOLD=2
# How many consecutive successes before recovery alert fires
ALERT_RECOVERY_THRESHOLD=2
# Seconds to wait before re-alerting the same target
ALERT_COOLDOWN_SECONDS=300
# Seconds a target must be stable before it's considered recovered
ALERT_STABILITY_WINDOW_SECONDS=300
# Throttle between CRITICAL alerts (seconds)
ALERT_CRITICAL_THROTTLE_SECONDS=60
# Throttle between WARNING alerts (seconds)
ALERT_WARNING_THROTTLE_SECONDS=300
# Throttle between MEDIUM alerts (seconds)
ALERT_MEDIUM_THROTTLE_SECONDS=600
# Minimum seconds between Telegram messages of the same type
TELEGRAM_THROTTLE_SECONDS=60
# Cache TTL for /telegram/status and /telegram/metrics (seconds)
TELEGRAM_CACHE_SECONDS=30

# ─────────────────────────────────────────────
# Webhooks outbound (optional)
# ─────────────────────────────────────────────
# Webhook signing secrets are configured per-subscription via the API
# (POST /admin/webhooks), not as global environment variables.
# Each subscription stores its own HMAC-SHA256 secret in the database.
# No global secret env var is required here.
#
# To register a webhook with a signing secret:
#   POST /admin/webhooks
#   { "url": "https://...", "secret": "your-per-webhook-secret", "events": ["down","up"] }
#
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
